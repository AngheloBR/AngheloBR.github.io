---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ '/' | absolute_url }}</loc><lastmod>{{ site.time | date: '%Y-%m-%d' }}</lastmod></url>
{%- assign labs = site.labs | sort: "card_order" %}
{%- for l in labs %}
  <url><loc>{{ l.url | absolute_url }}</loc><lastmod>{{ l.last_modified_at | default: site.time | date: '%Y-%m-%d' }}</lastmod></url>
{%- endfor %}
</urlset>
